# Central Server Environment Configuration
# Copy this to .env and fill in actual values.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rlvd_central
DB_USER=rlvd
DB_PASS=your_db_password

# --- Gemini AI (for Text-to-SQL) ---
# Get API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model: gemini-2.5-flash (default) or gemma-4-31b
# GEMINI_MODEL=gemini-2.5-flash

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=violations

# --- Bảo mật (auth) ---
# Secret JWT (>= 32 ký tự) — dùng: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_TTL_SECONDS=43200
# Token node biên dùng khi đẩy hồ sơ — trùng giá trị đặt ở edge
INGEST_TOKEN=change-me-node-ingest-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Bảo mật edge node ---
EDGE_API_TOKEN=change-me-edge-admin-token
EDGE_ALLOWED_ORIGINS=http://localhost:3000
EDGE_REQUIRE_TOKEN=false
