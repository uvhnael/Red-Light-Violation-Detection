# Central Server Environment Configuration
# Copy this to .env and fill in actual values.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rlvd_central
DB_USER=rlvd
DB_PASS=your_db_password

# --- Gemini AI (for Text-to-SQL) ---
# Get API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6LXGzK48zGEvebcur2ZxXw4vDFcAaOTBnCDHJ44CXZZIw

# Model: gemini-2.5-flash (default) or gemma-4-31b
# GEMINI_MODEL=gemini-2.5-flash

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=violations