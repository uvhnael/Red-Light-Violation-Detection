# ============================================================
# RLVD — Mẫu biến môi trường cho full stack (docker-compose.full.yml)
# Copy thành `.env` ở thư mục gốc rồi điền giá trị thật.
# Sinh secret:  openssl rand -base64 32   (JWT_SECRET)
#                openssl rand -hex 16      (INGEST_TOKEN / EDGE_API_TOKEN)
# ============================================================

# ---------- Bảo mật trung tâm (BẮT BUỘC production) ----------
# Secret chữ ký JWT — tối thiểu 32 ký tự, thiếu → central không khởi động
JWT_SECRET=change-me-to-a-long-random-string-32chars-minimum
# Tuổi access token (giây) — mặc định 43200 = 12 giờ
JWT_TTL_SECONDS=43200
# Token node biên dùng khi đẩy hồ sơ (header X-Ingest-Token) — PHẢI trùng giá trị edge set
INGEST_TOKEN=change-me-node-ingest-token
# Tài khoản admin seed lần đầu chạy (đổi default admin123!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ---------- Hạ tầng (đổi default khi ra production) ----------
# PostgreSQL — trùng giá trị DB_PASS mà service postgres dùng
DB_PASS=rlvd_secret
# MinIO — ACCESS/SECRET_KEY phải khớp ROOT_USER/PASSWORD
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- AI Text-to-SQL (tùy chọn — bỏ trống nếu không dùng) ----------
# Lấy key tại https://aistudio.google.com/apikey (dạng AIza...)
GEMINI_API_KEY=

# ---------- Node biên ----------
# Định danh node (hiện trên dashboard + trong event_id)
NODE_ID=edge-node-01
# Bảo mật control-plane edge (POST /action/*) — central forward token này
EDGE_API_TOKEN=
# true = bắt buộc token khi gọi /action/* (khuyến nghị production)
EDGE_REQUIRE_TOKEN=false
# CORS whitelist cho edge API — thêm domain production khi có HTTPS
EDGE_ALLOWED_ORIGINS=http://localhost:3000

# Nguồn video (tương đối từ gốc repo) + trọng số model
VIDEO_INPUT=data/videos/16h30.25.9.22.mp4
YOLO_MODEL_PATH=models/yolo26m_vehicle.pt
# GPU trống = auto-detect; hoặc "cpu"
YOLO_DEVICE=
# Vạch dừng có sẵn (tùy chọn): x1,y1,x2,y2 — bỏ trống để kẻ qua web UI
STOP_LINE=
# Hướng giám sát: any | positive_to_negative | negative_to_positive
CROSSING_DIRECTION=any

# Camera (hiện thị metadata trên web)
CAMERA_NAME=
CAMERA_LOCATION=

# Outbox sender — batch size + khoảng flush (giây)
OUTBOX_BATCH_SIZE=20
OUTBOX_FLUSH_INTERVAL=5
