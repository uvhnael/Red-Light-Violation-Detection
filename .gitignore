# ===== RLVD monorepo .gitignore =====
# Bao trùm: edge_node (Python), central_server (Spring/Java), web (Next.js),
# train_model (YOLO). Mỗi subproject có .gitignore riêng cho đặc thù của nó.

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/
# Project virtualenv (6.2G, torch/CUDA)
myenv/

# ----- Java / Spring (central_server) -----
target/
*.class

# ----- Node / Next.js (web) -----
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ----- Models and weights (too large for git) -----
*.pt
*.pth
*.onnx
*.engine
*.weights
*.h5
# Thư mục weights tải về / fine-tune (173M, toàn bộ là *.pt)
models/

# ----- YOLO training outputs & datasets (3.7G) -----
runs/
train_model/licenseplates/
train_traffic_light/dataset/
train_model/lincenseplate/licenseplates/
train_model/traffic_light_cls/dataset/
train_model/vehical_detection/vehicle.v1i.yolo26/
*.zip

# ----- Runtime data của edge node (HLS, video, outbox, calibration) -----
# data/ chứa segment .ts, video .mp4, SQLite outbox — sinh ra khi chạy pipeline.
data/
data/videos/
data/imgs/
*.db
*.sqlite
*.sqlite3

# ----- Logs -----
*.log
logs/

# ----- OS / editor -----
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ----- IDE -----
.idea/
.vscode/
*.iml
*.iws

# ----- Temp -----
temp/
.temp/

# ----- Local agent tooling -----
.hermes/
.agents/

# ----- Environment secrets -----
# KHÔNG BAO GIỜ commit .env thật — chỉ commit *.sample / *.example.
# Lưu ý: .env.* phải có negation cho file mẫu, nếu không .env.example /
# .env.sample (đang được track) sẽ bị loại khỏi repo.
.env
.env.*
!.env.sample
!.env.example
central_server/.env

# ----- Personal docs / scratch -----
*.docx
docx_output.txt
read_docx.py
web/upodate.md
# Ghi chú tuning tracker (làm việc cá nhân, chưa phải tài liệu dự án)
/tracker_update.md

# ----- Video ghi tay khi test pipeline ở thư mục gốc -----
# (run_pipeline.py --record out.mp4) — dùng `git add -f` nếu cần commit demo.
/*.mp4
/*.MP4
/*.avi
/*.mkv

# ----- Generated report intermediates -----
# spec.json / final-spec.json là output của build_docx.py / build_final_docx.py
# (script đã được track, output thì sinh lại được).
docs/report-assets/spec.json
docs/report-assets/final-spec.json
docs/report-assets/__pycache__/

# ----- Scratch cá nhân (log container, file tạm build báo cáo) -----
_red-light-violation-detection-*.txt
docs/report-assets/.tmp_*
