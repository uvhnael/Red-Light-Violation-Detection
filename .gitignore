# ===== Edge Node .gitignore =====

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.iml
*.iws

# Models and weights (too large for git)
*.pt
*.pth
*.onnx
*.engine
*.weights
*.h5

# Data files
data/videos/
data/imgs/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Temp
temp/
.temp/